# Application Environment
APP_NAME="Mini Enterprise Inventory & Financial Ledger Engine"
APP_ENV=development
APP_DEBUG=true
APP_URL=http://localhost:8080

# Database Configuration (Docker MySQL service)
DB_CONNECTION=mysql
